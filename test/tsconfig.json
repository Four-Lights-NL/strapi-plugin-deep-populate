{
  "extends": "@strapi/typescript-utils/tsconfigs/server",
  "compilerOptions": {
    "types": ["node", "vitest/globals"],
    "lib": ["ES2022"],
    "noEmit": true,
    "module": "es2022",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "paths": {
      "@test/*": ["./*"]
    },
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["./**/*.ts", "./**/*.d.ts"]
}
