{
  "version": "1.17.2-beta.0",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "populate",
    "strapi-v5"
  ],
  "type": "commonjs",
  "packageManager": "npm@11.16.0",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "build:test": "strapi-plugin build --sourcemap",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "pretest": "npm run build:test",
    "test": "npm-run-all --sequential typecheck test:unit test:integration test:admin",
    "test:unit": "vitest run --config test/vitest.unit.config.ts",
    "test:integration": "vitest run --config test/vitest.integration.config.ts",
    "test:memory": "vitest run --config test/vitest.memory.config.ts",
    "test:coverage": "vitest run --config test/vitest.coverage.config.ts",
    "test:types": "tsc -p test/tsconfig.json",
    "test:ts:back": "tsc -p server/tsconfig.json",
    "typecheck": "npm-run-all --parallel test:ts:back test:types test:ts:front",
    "ci": "biome ci server admin test",
    "release": "release-it",
    "playground:install": "cd playground && $npm_execpath install",
    "test:admin": "vitest run --config vitest.admin.config.ts",
    "test:ts:front": "tsc -p admin/tsconfig.json"
  },
  "dependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "lodash": "^4.17.21",
    "react-intl": "^6.6.2",
    "yup": "0.32.9"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@strapi/admin": "5.53.0",
    "@strapi/database": "5.53.0",
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "5.53.0",
    "@strapi/typescript-utils": "5.53.0",
    "@strapi/utils": "5.53.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.12",
    "better-sqlite3": "^12.4.1",
    "jsdom": "^26.1.0",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.3",
    "release-it": "^19.0.6",
    "simple-git": "^3.30.0",
    "styled-components": "^6.1.19",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.10"
  },
  "peerDependencies": {
    "@strapi/admin": "^5.0.0",
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/sdk-plugin": "^5",
    "@strapi/strapi": "^5",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "overrides": {
    "vite": "$vite",
    "esbuild": "0.27.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "deep-populate",
    "displayName": "Deep Populate",
    "description": "This plugin provides a simple way of retrieving all nested objects in a single request."
  },
  "name": "@fourlights/strapi-plugin-deep-populate",
  "description": "This plugin provides a simple way of retrieving all nested objects in a single request.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://git@github.com/Four-Lights-NL/strapi-plugin-deep-populate.git"
  },
  "bugs": {
    "url": "https://github.com/Four-Lights-NL/strapi-plugin-deep-populate/issues"
  },
  "homepage": "https://github.com/Four-Lights-NL/strapi-plugin-deep-populate#readme",
  "author": "Four Lights <engineering@fourlights.nl>",
  "publishConfig": {
    "access": "public"
  }
}
